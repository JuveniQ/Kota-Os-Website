---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FinalCta from "@/components/FinalCta.astro";
import { CONTACT_INFO } from "@/data/site-config";
import { loadReleaseCatalog } from "@/data/release-catalog";
import { organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const { latest, versions } = loadReleaseCatalog();
const universal = latest?.artifacts.find((artifact) => artifact.abi === "universal");
const smaller = latest?.artifacts.filter((artifact) => artifact.abi !== "universal") ?? [];
const abiNames = { "arm64-v8a": "64-bit ARM", "armeabi-v7a": "32-bit ARM" };
---

<BaseLayout
  title="Download Kota-OS for Android | Official Installer"
  description="Get the official Kota-OS Android installer, read installation instructions, verify the APK and browse version changes."
  path="/download"
  jsonLd={[softwareApplicationSchema("/download"), organizationSchema()]}
>
  <PageHero
    title="Download Kota-OS"
    subtitle="Food-business operations for Android. Get the official website edition, check the installer details and follow the steps below."
    badge="Android website edition"
  />

  <section class="section-pad">
    <div class="container-wide grid gap-7 lg:grid-cols-[minmax(0,1.35fr),minmax(300px,0.65fr)]">
      <article class="card-base rounded-3xl p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-5">
          <span class="app-icon block h-20 w-20 shrink-0 rounded-[22px]" aria-hidden="true">
            <picture><source srcset="/logo.webp" type="image/webp" /><img src="/logo.jpeg" alt="" width="80" height="80" /></picture>
          </span>
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-brand-primary">Official Android APK</p>
            <h2 class="mt-1 text-3xl font-extrabold text-brand-foreground">Kota-OS {latest ? `v${latest.version}` : "for Android"}</h2>
            <p class="mt-1 text-sm text-brand-muted">Website edition · {latest ? `Released ${latest.date}` : "Release details pending"}</p>
          </div>
        </div>

        {universal ? (
          <>
            <p class="mt-6 text-brand-muted">Choose the standard installer if you are unsure which Android processor your phone uses.</p>
            <a href={universal.url} class="btn-primary mt-6 inline-flex min-h-12 items-center"
              rel="noopener noreferrer" data-track-external="true" data-track-source="website-apk-universal">
              Download for Android · {universal.sizeLabel}
            </a>
            <dl class="mt-7 grid gap-4 text-sm sm:grid-cols-2">
              <div><dt class="font-semibold text-brand-foreground">File name</dt><dd class="mt-1 break-all text-brand-muted">{universal.fileName}</dd></div>
              <div><dt class="font-semibold text-brand-foreground">File size</dt><dd class="mt-1 text-brand-muted">{universal.sizeLabel} ({universal.sizeBytes.toLocaleString("en-ZA")} bytes)</dd></div>
              <div class="sm:col-span-2"><dt class="font-semibold text-brand-foreground">APK SHA-256</dt><dd class="mt-1 break-all font-mono text-xs text-brand-muted">{universal.sha256}</dd></div>
              <div class="sm:col-span-2"><dt class="font-semibold text-brand-foreground">Signing certificate SHA-256</dt><dd class="mt-1 break-all font-mono text-xs text-brand-muted">{universal.signingCertSha256}</dd></div>
            </dl>
          </>
        ) : (
          <div class="mt-6 rounded-2xl border border-brand-border bg-brand-background p-5">
            <p class="font-semibold text-brand-foreground">Installer coming soon</p>
            <p class="mt-2 text-sm leading-relaxed text-brand-muted">The verified website APK has not been published yet. Version, size, hash and the download button will appear here together when the signed file is ready.</p>
            <a href={`mailto:${CONTACT_INFO.email}?subject=Kota-OS%20Android%20release`} class="mt-3 inline-flex text-sm font-semibold text-brand-primary underline">Ask about availability</a>
          </div>
        )}
      </article>

      <aside class="card-base rounded-3xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-brand-foreground">Before you install</h2>
        <ul class="mt-5 list-disc space-y-3 pl-5 text-sm leading-relaxed text-brand-muted">
          <li>Use this page and check the file size and SHA-256 shown here against your downloaded file.</li>
          <li>Android may ask you to allow installs from your browser or file manager. Only allow the source you used, and turn that permission off afterward.</li>
          <li>Keep Play Protect on. Stop and contact support if Android reports a security concern.</li>
          <li>Sales, menus and stock stay on this device. Account access on up to three devices does not sync shop records. Save a business backup outside the phone after each service.</li>
        </ul>
        <a class="mt-5 inline-block text-sm font-semibold text-brand-primary underline" href={`mailto:${CONTACT_INFO.email}`}>Need help? {CONTACT_INFO.email}</a>
      </aside>
    </div>
  </section>

  {smaller.length > 0 && (
    <section class="section-pad bg-white">
      <div class="container-wide max-w-5xl">
        <h2 class="text-3xl font-extrabold text-brand-foreground">Smaller Android installers</h2>
        <p class="mt-3 text-brand-muted">These files contain native libraries for a specific processor. Choose one only if you know your device architecture; the standard installer above works across supported Android processors.</p>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {smaller.map((artifact) => (
            <article class="card-base rounded-2xl p-5">
              <h3 class="text-xl font-bold text-brand-foreground">{abiNames[artifact.abi as keyof typeof abiNames]}</h3>
              <p class="mt-2 text-sm text-brand-muted">{artifact.fileName} · {artifact.sizeLabel} ({artifact.sizeBytes.toLocaleString("en-ZA")} bytes)</p>
              <a href={artifact.url} class="btn-secondary mt-4 inline-flex" rel="noopener noreferrer"
                data-track-external="true" data-track-source={`website-apk-${artifact.abi}`}>
                Download {abiNames[artifact.abi as keyof typeof abiNames]}
              </a>
              <p class="mt-4 break-all text-xs text-brand-muted"><strong>APK SHA-256:</strong> <span class="font-mono">{artifact.sha256}</span></p>
              <p class="mt-2 break-all text-xs text-brand-muted"><strong>Signing certificate SHA-256:</strong> <span class="font-mono">{artifact.signingCertSha256}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-pad bg-brand-surface/45">
    <div class="container-wide max-w-5xl">
      <h2 class="text-3xl font-extrabold text-brand-foreground">Install and get started</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-2">
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">1. Download</strong><p class="mt-2 text-sm text-brand-muted">Save the official APK from this page. Check that the file name and size match the listing.</p></li>
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">2. Verify</strong><p class="mt-2 text-sm text-brand-muted">Compare the file SHA-256 before opening it. If it differs, delete the file and contact support.</p></li>
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">3. Install</strong><p class="mt-2 text-sm text-brand-muted">Open the APK in Downloads. Approve your browser or file manager as an installation source only when Android asks, then remove that permission when finished.</p></li>
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">4. Back up</strong><p class="mt-2 text-sm text-brand-muted">Sign in, set up a menu and start selling. After service, use Settings → Business backup and keep the saved JSON somewhere outside your phone.</p></li>
      </ol>
      {universal && (
        <div class="mt-6 rounded-2xl border border-brand-border bg-white p-5 text-sm text-brand-muted">
          <h3 class="font-bold text-brand-foreground">Verify the standard APK</h3>
          <p class="mt-2">Windows PowerShell: <code class="break-all">Get-FileHash "{universal.fileName}" -Algorithm SHA256</code></p>
          <p class="mt-1">macOS: <code class="break-all">shasum -a 256 "{universal.fileName}"</code></p>
          <p class="mt-1">Linux: <code class="break-all">sha256sum "{universal.fileName}"</code></p>
          <p class="mt-2">With Android SDK: <code class="break-all">apksigner verify --print-certs "{universal.fileName}"</code></p>
        </div>
      )}
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide max-w-5xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><h2 class="text-3xl font-extrabold text-brand-foreground">Version history</h2><p class="mt-2 text-brand-muted">Features and fixes from earlier versions.</p></div>
        <a href="/updates" class="text-sm font-semibold text-brand-primary underline">All release notes</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {versions.map((release) => (
          <article class="card-base rounded-2xl p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-primary">v{release.version} · {release.date}</p>
            <h3 class="mt-2 text-lg font-bold text-brand-foreground">{release.summary}</h3>
            <p class="mt-3 text-sm text-brand-muted">Features: {release.features.join(", ") || "—"}</p>
            <p class="mt-2 text-sm text-brand-muted">Fixes: {release.fixes.join(", ") || "—"}</p>
            <a class="mt-3 inline-block text-sm font-semibold text-brand-primary underline" href={`/downloads/v${release.version}/changelog.json`}>View changelog JSON</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FinalCta title="Ready for a smoother service?" subtitle="See how Kota-OS helps you record sales, ingredients and stock even through an outage." />
</BaseLayout>
