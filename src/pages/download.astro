---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FinalCta from "@/components/FinalCta.astro";
import { CONTACT_INFO } from "@/data/site-config";
import { getDirectRelease } from "@/data/direct-release";
import { createWhatsAppUrl } from "@/lib/whatsapp";
import { organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const release = getDirectRelease();
const whatsappUrl = createWhatsAppUrl(
  CONTACT_INFO.primaryPhone,
  "Hi Kota-OS, I run a food business in Gauteng and would like to join the guided pilot."
);
---

<BaseLayout
  title="Kota-OS Android | Gauteng Pilot"
  description="Request a place in the Kota-OS Gauteng food-business pilot. Verified Android release details appear here when a signed installer is ready."
  path="/download"
  jsonLd={[softwareApplicationSchema("/download"), organizationSchema()]}
>
  <PageHero
    title="Get Kota-OS"
    subtitle="Join the guided Gauteng pilot. We are onboarding food businesses in small groups so we can support each shop through real trading."
    badge="Gauteng pilot"
  />

  <section class="section-pad">
    <div class="container-wide grid gap-6 lg:grid-cols-[1.2fr,0.8fr]">
      <article class="card-base rounded-2xl p-8">
        {release ? (
          <>
            <p class="text-sm font-bold uppercase tracking-wide text-brand-primary">Official website build</p>
            <h2 class="mt-2 text-3xl font-extrabold text-brand-foreground">Kota-OS v{release.version}</h2>
            <p class="mt-3 text-brand-muted">
              Android APK · {release.sizeLabel} · Released {release.releaseDate}
            </p>
            <a href={release.url} class="btn-primary mt-6 inline-flex" rel="noopener noreferrer"
              data-track-external="true" data-track-source="official-website-apk">
              Download signed Android APK
            </a>
            <p class="mt-4 text-sm text-brand-muted">Download only from this page. Verify the file hash and signing certificate against the values below before installing.</p>
            <dl class="mt-6 space-y-4 text-sm">
              <div><dt class="font-bold text-brand-foreground">File</dt><dd class="mt-1 break-all text-brand-muted">{release.fileName}</dd></div>
              <div><dt class="font-bold text-brand-foreground">SHA-256 file hash</dt><dd class="mt-1 break-all font-mono text-xs text-brand-muted">{release.sha256}</dd></div>
              <div><dt class="font-bold text-brand-foreground">Signing certificate SHA-256</dt><dd class="mt-1 break-all font-mono text-xs text-brand-muted">{release.signingCertSha256}</dd></div>
            </dl>
          </>
        ) : (
          <>
            <p class="text-sm font-bold uppercase tracking-wide text-brand-primary">Pilot access</p>
            <h2 class="mt-2 text-3xl font-extrabold text-brand-foreground">Request a guided setup</h2>
            <p class="mt-3 text-brand-muted">
              The next verified website installer is being prepared. Contact our team to register interest and get an approved installation link when your pilot place is confirmed.
            </p>
            <a href={whatsappUrl} class="btn-primary mt-6 inline-flex" target="_blank"
              rel="noopener noreferrer" data-track-external="true" data-track-source="pilot-request">
              Request pilot access on WhatsApp
            </a>
            <p class="mt-4 text-sm text-brand-muted">You can also write to <a class="text-brand-primary underline" href="mailto:contact@juveniq.co.za">contact@juveniq.co.za</a>.</p>
          </>
        )}
      </article>
      <aside class="card-base rounded-2xl p-6">
        <h2 class="text-xl font-bold text-brand-foreground">Where to get it</h2>
        <ul class="mt-4 space-y-4 text-sm text-brand-muted">
          <li><strong class="text-brand-foreground">Website:</strong> pilot requests open; verified installer details appear here after release checks.</li>
          <li><strong class="text-brand-foreground">Samsung Galaxy Store:</strong> being prepared; store billing and test purchases must pass review.</li>
          <li><strong class="text-brand-foreground">Huawei AppGallery and Aptoide:</strong> planned after each store's billing and publishing requirements are validated.</li>
          <li><strong class="text-brand-foreground">APKPure:</strong> publisher and update controls are being evaluated.</li>
        </ul>
        <p class="mt-5 text-sm text-brand-muted">Account access is shared across channels after you sign in. Purchase options depend on the store where you installed the app.</p>
      </aside>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide max-w-4xl">
      <h2 class="text-3xl font-extrabold text-brand-foreground">Installing a direct APK</h2>
      <ol class="mt-5 list-decimal space-y-3 pl-5 text-brand-muted">
        <li>Open the approved link from this page and check the version, file size and SHA-256.</li>
        <li>Android may ask you to allow installation from the app you used to download the APK. Allow it for that app only if you recognize this release.</li>
        <li>Keep Play Protect enabled. If your device reports a security concern, stop installation and contact support.</li>
        <li>Sign in with your verified account, set up your menu and record a first sale. The 14-day trial starts at registration.</li>
      </ol>
      <p class="mt-5 text-sm text-brand-muted">An Android security prompt for direct installs is expected. We cannot remove that system protection; store installs provide a smoother installation path.</p>
      {release && (
        <div class="mt-6 rounded-xl border border-brand-border bg-brand-background p-4 text-sm text-brand-muted">
          <h3 class="font-bold text-brand-foreground">Check the downloaded file</h3>
          <p class="mt-2">On Windows: <code>Get-FileHash "Kota-OS.apk" -Algorithm SHA256</code></p>
          <p>On macOS: <code>shasum -a 256 Kota-OS.apk</code></p>
          <p>On Linux: <code>sha256sum Kota-OS.apk</code></p>
        </div>
      )}
    </div>
  </section>
  <FinalCta title="Join the Gauteng pilot" subtitle="Tell us about your food business and we will help you get started." />
</BaseLayout>
