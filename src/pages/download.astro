---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FinalCta from "@/components/FinalCta.astro";
import DownloadSelector from "@/components/DownloadSelector";
import { CONTACT_INFO } from "@/data/site-config";
import { loadReleaseCatalog } from "@/data/release-catalog";
import { organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const { latest, versions } = loadReleaseCatalog();
---

<BaseLayout
  title="Download Kota-OS for Android | Official Installer"
  description="Choose the official Kota-OS Android installer for your phone, check its file information and follow the installation steps."
  path="/download"
  jsonLd={[softwareApplicationSchema("/download"), organizationSchema()]}
>
  <PageHero
    title="Download Kota-OS"
    subtitle="Food-business operations for Android. Find the website edition for your phone and check its details before installing."
    badge="Android website edition"
  />

  <section class="section-pad">
    <div class="container-wide grid gap-7 lg:grid-cols-[minmax(0,1.35fr),minmax(300px,0.65fr)]">
      <article class="card-base rounded-3xl p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-5">
          <span class="app-icon block h-20 w-20 shrink-0 rounded-[22px]" aria-hidden="true">
            <picture><source srcset="/logo.webp" type="image/webp" /><img src="/logo.jpeg" alt="" width="80" height="80" /></picture>
          </span>
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-brand-primary">Official Android APK</p>
            <h2 class="mt-1 text-3xl font-extrabold text-brand-foreground">Kota-OS {latest ? `v${latest.version}` : "for Android"}</h2>
            <p class="mt-1 text-sm text-brand-muted">Website edition · {latest ? `Released ${latest.date}` : "Release details pending"}</p>
          </div>
        </div>

        {latest ? (
          <DownloadSelector client:load version={latest.version} date={latest.date} installers={latest.artifacts} />
        ) : (
          <div class="mt-6 rounded-2xl border border-brand-border bg-brand-background p-5">
            <p class="font-semibold text-brand-foreground">Installers coming soon</p>
            <p class="mt-2 text-sm leading-relaxed text-brand-muted">The signed Android files have not been published yet. This page will show the correct file, its size and its signature after both phone variants have been verified.</p>
            <a href={`mailto:${CONTACT_INFO.email}?subject=Kota-OS%20Android%20release`} class="mt-3 inline-flex text-sm font-semibold text-brand-primary underline">Ask about availability</a>
          </div>
        )}
      </article>

      <aside class="card-base rounded-3xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-brand-foreground">Before you install</h2>
        <ul class="mt-5 list-disc space-y-3 pl-5 text-sm leading-relaxed text-brand-muted">
          <li>Use the match shown for your phone. If the browser cannot identify your processor, check the device specifications or ask support before choosing a file.</li>
          <li>Compare the downloaded file size and SHA-256 with the selected APK's details.</li>
          <li>Android may ask you to allow installs from your browser or file manager. Allow only the source you used, then turn that permission off afterward.</li>
          <li>Keep Play Protect on. Stop and contact support if Android reports a security concern.</li>
          <li>Sales, menus and stock stay on this device. Account access on up to three devices does not sync shop records. Save a business backup outside the phone after each service.</li>
        </ul>
        <a class="mt-5 inline-block text-sm font-semibold text-brand-primary underline" href={`mailto:${CONTACT_INFO.email}`}>Need help? {CONTACT_INFO.email}</a>
      </aside>
    </div>
  </section>

  <section class="section-pad bg-brand-surface/45">
    <div class="container-wide max-w-5xl">
      <h2 class="text-3xl font-extrabold text-brand-foreground">Install and get started</h2>
      <ol class="mt-6 grid gap-4 md:grid-cols-2">
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">1. Find your file</strong><p class="mt-2 text-sm text-brand-muted">Tap “Find my Android download.” If the browser cannot detect the processor, choose the architecture from your phone's specifications.</p></li>
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">2. Download and verify</strong><p class="mt-2 text-sm text-brand-muted">Review the selected APK's file name, size and SHA-256. If the downloaded file differs, delete it and contact support.</p></li>
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">3. Install</strong><p class="mt-2 text-sm text-brand-muted">Open the APK in Downloads. Approve your browser or file manager as an installation source only when Android asks, then remove that permission when finished.</p></li>
        <li class="card-base rounded-2xl p-5"><strong class="text-brand-foreground">4. Back up</strong><p class="mt-2 text-sm text-brand-muted">Sign in, set up a menu and start selling. After service, use Settings → Business backup and keep the saved JSON somewhere outside your phone.</p></li>
      </ol>
      {latest && (
        <div class="mt-6 rounded-2xl border border-brand-border bg-white p-5 text-sm text-brand-muted">
          <h3 class="font-bold text-brand-foreground">Check the APK you selected</h3>
          <p class="mt-2">Windows PowerShell: <code>Get-FileHash "filename.apk" -Algorithm SHA256</code></p>
          <p class="mt-1">macOS: <code>shasum -a 256 "filename.apk"</code></p>
          <p class="mt-1">Linux: <code>sha256sum "filename.apk"</code></p>
          <p class="mt-2">With Android SDK: <code>apksigner verify --print-certs "filename.apk"</code></p>
          <p class="mt-2">Replace <code>filename.apk</code> with the file name shown above and compare the output with the selected APK's hashes.</p>
        </div>
      )}
    </div>
  </section>

  {versions.length > 0 && (
    <section class="section-pad bg-white">
      <div class="container-wide max-w-5xl">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div><h2 class="text-3xl font-extrabold text-brand-foreground">Version history</h2><p class="mt-2 text-brand-muted">Published features and fixes.</p></div>
          <a href="/updates" class="text-sm font-semibold text-brand-primary underline">All release notes</a>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {versions.map((release) => (
            <article class="card-base rounded-2xl p-5">
              <p class="text-xs font-bold uppercase tracking-wide text-brand-primary">v{release.version} · {release.date}</p>
              <h3 class="mt-2 text-lg font-bold text-brand-foreground">{release.summary}</h3>
              <p class="mt-3 text-sm text-brand-muted">Features: {release.features.join(", ") || "—"}</p>
              <p class="mt-2 text-sm text-brand-muted">Fixes: {release.fixes.join(", ") || "—"}</p>
              <a class="mt-3 inline-block text-sm font-semibold text-brand-primary underline" href={`/downloads/v${release.version}/changelog.json`}>View changelog JSON</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCta title="Ready for a smoother service?" subtitle="See how Kota-OS helps you record sales, ingredients and stock even through an outage." />
</BaseLayout>
