---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import StatusPill from "@/components/StatusPill";
import FinalCta from "@/components/FinalCta.astro";
import LeadCaptureModal from "@/components/LeadCaptureModal";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { CONTACT_INFO, DOWNLOAD_META } from "@/data/site-config";
import { RELEASE_NOTES } from "@/data/home-content";
import { getLatestApkMeta } from "@/lib/apk-meta";
import { createWhatsAppUrl } from "@/lib/whatsapp";
import { organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const latest = RELEASE_NOTES[0];
const jsonLd = [softwareApplicationSchema("/download"), organizationSchema()];
const apkMeta = getLatestApkMeta(latest?.date ?? DOWNLOAD_META.releaseDate);
const hasRealApk = Boolean(apkMeta);
const qrImagePath = "/assets/kota-os-download-qr-v1-0-3.png";
const qrImageAbsolutePath = fileURLToPath(new URL("../../public/assets/kota-os-download-qr-v1-0-3.png", import.meta.url));
const hasQrImage = existsSync(qrImageAbsolutePath);

const downloadData = apkMeta
  ? {
      name: apkMeta.fileName,
      version: apkMeta.version,
      size: apkMeta.sizeLabel,
      releaseDate: apkMeta.releaseDate,
      apkUrl: apkMeta.downloadPath,
      checksumSha256: apkMeta.sha256
    }
  : {
      name: `Kota-OS v${DOWNLOAD_META.version}.apk`,
      version: DOWNLOAD_META.version,
      size: DOWNLOAD_META.size,
      releaseDate: DOWNLOAD_META.releaseDate,
      apkUrl: DOWNLOAD_META.apkUrl,
      checksumSha256: DOWNLOAD_META.checksumSha256
    };
const qrTargetUrl = `https://kotaos.juveniq.co.za${downloadData.apkUrl}`;
const trustBadges = [
  "Official Source: kotaos.juveniq.co.za",
  "SHA-256 Published for Every Release",
  "JuveniQ Security Scan Completed",
  "Manual Install Required (Not on Play Store Yet)"
];
const whatsappQuickConnectMessage = "Hi Kota-OS, I need help setting up my 30-day trial.";
const whatsappQuickConnectUrl = createWhatsAppUrl(
  CONTACT_INFO.primaryPhone,
  whatsappQuickConnectMessage
);
---

<BaseLayout
  title="Download Kota-OS APK | Official Installer"
  description="Download the official Kota-OS Android APK, verify release details, and follow the secure installation guide."
  path="/download"
  jsonLd={jsonLd}
>
  <PageHero
    title="Download Kota-OS APK"
    subtitle="Install the latest official build and start your full 30-day free trial while commercial plans are being finalized."
    badge="Official Android Download"
  />

  <section class="section-pad">
    <div class="container-wide grid gap-6 lg:grid-cols-[1.1fr,0.9fr]">
      <article class="rounded-3xl border border-brand-primary/40 bg-white p-8 shadow-warm">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-3xl font-extrabold text-brand-foreground">{downloadData.name}</h2>
          <StatusPill tone="warning" label="Not verified by Google Play Protect" />
        </div>

        <dl class="mt-6 grid gap-4 text-sm md:grid-cols-3">
          <div class="rounded-xl bg-brand-background p-4">
            <dt class="text-brand-muted">Version</dt>
            <dd class="mt-1 text-xl font-bold text-brand-foreground">{downloadData.version}</dd>
          </div>
          <div class="rounded-xl bg-brand-background p-4">
            <dt class="text-brand-muted">Size</dt>
            <dd class="mt-1 text-xl font-bold text-brand-foreground">{downloadData.size}</dd>
          </div>
          <div class="rounded-xl bg-brand-background p-4">
            <dt class="text-brand-muted">Release Date</dt>
            <dd class="mt-1 text-xl font-bold text-brand-foreground">{downloadData.releaseDate}</dd>
          </div>
        </dl>

        <a
          href={downloadData.apkUrl}
          class:list={["btn-primary mt-6 w-full text-center", !hasRealApk && "pointer-events-none opacity-70"]}
        >
          {hasRealApk ? `Download Kota-OS v${downloadData.version}` : "APK Upload Pending"}
        </a>
        <LeadCaptureModal client:load />
        <div class="mt-4 flex flex-wrap gap-2">
          {trustBadges.map((badge) => (
            <span class="rounded-full border border-brand-border bg-brand-background px-3 py-1 text-xs font-semibold text-brand-foreground">
              {badge}
            </span>
          ))}
        </div>
        <p class="mt-3 text-xs leading-relaxed text-brand-muted">
          Play Protect may warn because this app is distributed directly. Verify checksum and download only from the
          official Kota-OS domain.
        </p>

        {!hasRealApk && (
          <p class="mt-3 text-sm text-brand-muted">
            The latest APK has not been uploaded yet. Please contact support for the approved download channel.
          </p>
        )}

        <div class="mt-4 rounded-xl border border-brand-border bg-brand-card p-4">
          <p class="text-xs uppercase tracking-wide text-brand-muted">SHA-256 Checksum</p>
          <p class="mt-1 break-all font-mono text-sm text-brand-foreground">{downloadData.checksumSha256}</p>
        </div>

        <p class="mt-4 text-sm leading-relaxed text-brand-muted">
          {DOWNLOAD_META.playProtectNote}
        </p>
      </article>

      <aside class="space-y-6">
        <article class="card-base rounded-2xl p-6">
          <h3 class="text-xl font-bold text-brand-foreground">Scan to Download</h3>
          <p class="mt-2 text-sm text-brand-muted">
            {hasQrImage
              ? "Scan to open the official Kota-OS APK download URL instantly."
              : "QR code will appear once the official APK release is published."}
          </p>
          <div class="mt-4 grid h-48 place-items-center rounded-xl border-2 border-dashed border-brand-border bg-brand-background">
            {hasQrImage ? (
              <img
                src={qrImagePath}
                alt="QR code linking to the official Kota-OS APK download URL"
                class="h-36 w-36 rounded-lg border border-brand-border bg-white p-2"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <p class="text-sm font-semibold text-brand-muted">QR Pending</p>
            )}
          </div>
          {hasQrImage && (
            <p class="mt-3 break-all text-xs text-brand-muted">
              QR target: {qrTargetUrl}
            </p>
          )}
        </article>

        <article class="card-base rounded-2xl p-6">
          <h3 class="text-xl font-bold text-brand-foreground">Trust Signals</h3>
          <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-brand-muted">
            <li>Safe and secure release workflow</li>
            <li>{DOWNLOAD_META.androidCompatibility}</li>
            <li>Official support at contact@juveniq.co.za</li>
            <li>Not verified by Google Play Protect (current status)</li>
          </ul>
        </article>

        <article class="card-base rounded-2xl p-6">
          <h3 class="text-xl font-bold text-brand-foreground">Security &amp; Trust</h3>
          <p class="mt-2 text-sm text-brand-muted">
            Because Kota-OS is distributed directly and not through Google Play, Android may show a
            Play Protect warning. This does not automatically mean the APK is malicious. Verify the
            file hash before installation.
          </p>

          <div class="mt-4 rounded-xl border border-brand-border bg-brand-background p-4">
            <p class="text-xs uppercase tracking-wide text-brand-muted">Official SHA-256</p>
            <p class="mt-1 break-all font-mono text-sm text-brand-foreground">{downloadData.checksumSha256}</p>
          </div>

          <div class="mt-4 space-y-3 text-sm">
            <div class="rounded-xl border border-brand-border bg-white p-3">
              <p class="font-semibold text-brand-foreground">Windows (PowerShell)</p>
              <code class="mt-1 block break-all text-xs text-brand-muted">
                {`Get-FileHash ".\\${downloadData.name}" -Algorithm SHA256`}
              </code>
            </div>
            <div class="rounded-xl border border-brand-border bg-white p-3">
              <p class="font-semibold text-brand-foreground">macOS</p>
              <code class="mt-1 block break-all text-xs text-brand-muted">
                {`shasum -a 256 "${downloadData.name}"`}
              </code>
            </div>
            <div class="rounded-xl border border-brand-border bg-white p-3">
              <p class="font-semibold text-brand-foreground">Linux</p>
              <code class="mt-1 block break-all text-xs text-brand-muted">
                {`sha256sum "${downloadData.name}"`}
              </code>
            </div>
          </div>

          <p class="mt-4 text-xs text-brand-muted">
            Install only if the computed hash matches exactly.
          </p>
        </article>
      </aside>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide">
      <SectionHeader
        title="After Download: 3 Steps to Start Fast"
        subtitle="Reduce setup delays and launch your 30-day trial with confidence."
      />
      <ol class="grid gap-4 md:grid-cols-3">
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 1</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Install Safely</h3>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-brand-muted">
            <li>Download only from the official page</li>
            <li>Enable install from trusted source</li>
          </ul>
        </li>
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 2</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Open and Set Up Store</h3>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-brand-muted">
            <li>Add shop details and first menu items</li>
            <li>Complete core setup in minutes</li>
          </ul>
        </li>
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 3</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Activate Guided Trial Start</h3>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-brand-muted">
            <li>Use one-tap WhatsApp setup support</li>
            <li>Send a prefilled message for faster help</li>
          </ul>
          <a
            href={whatsappQuickConnectUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-external="true"
            data-track-source="download-onboarding"
            class="btn-primary mt-4 w-full justify-center"
          >
            Get WhatsApp Setup Help
          </a>
        </li>
      </ol>
    </div>
  </section>

  <section class="section-pad bg-brand-surface/45">
    <div class="container-wide">
      <SectionHeader title="4-Step Installation Guide" />
      <ol class="grid gap-4 md:grid-cols-2">
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 1</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Download Official APK</h3>
          <p class="mt-2 text-brand-muted">Use the official link from this page or support channels.</p>
        </li>
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 2</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Allow APK Installation</h3>
          <p class="mt-2 text-brand-muted">
            Enable installation from trusted sources in Android settings.
          </p>
        </li>
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 3</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Complete Setup</h3>
          <p class="mt-2 text-brand-muted">
            Configure store details, menu items, pricing, and payment methods.
          </p>
        </li>
        <li class="card-base rounded-2xl p-6">
          <p class="text-xs uppercase tracking-wide text-brand-muted">Step 4</p>
          <h3 class="mt-2 text-xl font-bold text-brand-foreground">Start 30-Day Trial</h3>
          <p class="mt-2 text-brand-muted">
            Use all core features during your 30-day free trial while commercial plans are being finalized.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide">
      <SectionHeader title="Release Highlights" />
      <article class="card-base rounded-2xl p-8">
        <h3 class="text-2xl font-bold text-brand-foreground">v{latest.version} - {latest.summary}</h3>
        <div class="mt-4 grid gap-5 md:grid-cols-2">
          <div>
            <h4 class="text-sm font-bold uppercase tracking-wide text-brand-foreground">What is New</h4>
            <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-brand-muted">
              {latest.features.map((feature) => <li>{feature}</li>)}
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-bold uppercase tracking-wide text-brand-foreground">Stability Fixes</h4>
            <ul class="mt-2 list-disc space-y-2 pl-5 text-sm text-brand-muted">
              {latest.fixes.map((fix) => <li>{fix}</li>)}
            </ul>
          </div>
        </div>
      </article>
    </div>
  </section>

  <FinalCta title="Need installation help?" subtitle="Contact our team if you need help installing or activating Kota-OS." />
</BaseLayout>
