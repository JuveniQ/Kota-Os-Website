---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { CONTACT_INFO, LEGAL_INFO } from "@/data/site-config";
import { organizationSchema } from "@/lib/seo";

const jsonLd = [organizationSchema()];
---

<BaseLayout
  title="Privacy Policy | Kota-OS"
  description="Read how Kota-OS and JuveniQ process personal information in line with POPIA."
  path="/privacy-policy"
  jsonLd={jsonLd}
>
  <PageHero
    title="Privacy Policy"
    subtitle="This policy explains how Kota-OS, operated by JuveniQ, processes personal information in line with POPIA."
    badge="POPIA-Aligned"
  />

  <section class="section-pad">
    <div class="container-wide max-w-4xl space-y-6">
      <article class="card-base rounded-2xl p-6">
        <p class="text-sm text-brand-muted">Effective Date: February 14, 2026</p>
        <p class="mt-1 text-sm text-brand-muted">Last Updated: February 14, 2026</p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Responsible Party</h2>
        <p class="mt-3 text-brand-muted">
          Kota-OS is operated by {LEGAL_INFO.responsibleParty}. For POPIA purposes, JuveniQ is the
          Responsible Party for personal information collected through this marketing website.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-brand-muted">
          <li>Responsible Party: {LEGAL_INFO.responsibleParty}</li>
          <li>Company Registration Number: {LEGAL_INFO.companyRegistrationNumber}</li>
          <li>Email: {CONTACT_INFO.email}</li>
          <li>Phone: {CONTACT_INFO.phone}</li>
          <li>Location: {CONTACT_INFO.location}, South Africa</li>
        </ul>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">What We Collect and Why</h2>
        <p class="mt-3 text-brand-muted">
          We collect names, email addresses, phone numbers, and enquiry details to support trial
          setup and customer support operations.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-brand-muted">
          <li>Responding to contact and support requests</li>
          <li>Preparing and assisting 30-day trial onboarding</li>
          <li>Operational and service-quality communications</li>
          <li>Security monitoring and abuse prevention</li>
        </ul>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Data Subject Requests</h2>
        <p class="mt-3 text-brand-muted">
          You may request access, correction, or deletion of your personal information.
        </p>
        <p class="mt-3 text-brand-muted">
          To submit a request, email <a href={`mailto:${CONTACT_INFO.email}`} class="text-brand-primary underline">{CONTACT_INFO.email}</a> with
          the subject line <span class="font-semibold text-brand-foreground">POPIA Data Request</span>. Include enough detail for us
          to identify your records and verify your identity.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Retention and Security</h2>
        <p class="mt-3 text-brand-muted">
          We keep personal information only as long as needed for the purposes above and legal
          requirements. We apply reasonable technical and organizational safeguards to protect data.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
