---
import FinalCta from "@/components/FinalCta.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { CONTACT_INFO, LEGAL_INFO } from "@/data/site-config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localBusinessSchema, organizationSchema } from "@/lib/seo";

const jsonLd = [organizationSchema(), localBusinessSchema("/about")];

const WHO_WE_SERVE = [
  {
    title: "Township Kota & Takeaway Stalls",
    description:
      "For vendors handling fast walk-up traffic, Kota-OS keeps sales moving with a clear flow that reduces order delays and mistakes."
  },
  {
    title: "Taxi Rank Food Counters",
    description:
      "For high-volume rush periods, staff can process orders quickly and maintain consistency even when internet connectivity is unstable."
  },
  {
    title: "Growing Neighborhood Vendors",
    description:
      "For businesses scaling operations, Kota-OS helps organize inventory and reporting across daily operations from one practical system."
  }
];

const TRUST_BLOCKS = [
  {
    title: "Offline-First Reliability",
    description:
      "Keep selling without internet interruptions and continue serving customers with confidence during network downtime."
  },
  {
    title: "Fast Daily Sales Flow",
    description:
      "Built to reduce queue time during busy trading hours, helping teams complete transactions with minimal steps."
  },
  {
    title: "Inventory and Report Clarity",
    description:
      "Track stock movement and export clean reports so vendors can make better decisions on products and purchasing."
  },
  {
    title: "Direct Support from JuveniQ",
    description:
      "Get responsive product support from the team behind Kota-OS, with practical help for rollout and day-to-day usage."
  }
];
---

<BaseLayout
  title="About Kota-OS | Built for Township Food Vendors"
  description="Learn how Kota-OS helps township food vendors run fast, offline-first operations with dependable support from JuveniQ."
  path="/about"
  jsonLd={jsonLd}
>
  <PageHero
    badge="Built in South Africa"
    title="About Kota-OS"
    subtitle="Kota-OS is built by JuveniQ for township fast-food vendors who need speed, reliability, and offline-first operations every day."
  />

  <section class="section-pad">
    <div class="container-wide">
      <SectionHeader title="Our Mission" align="left" />
      <div class="max-w-4xl space-y-4 text-base leading-relaxed text-brand-muted md:text-lg">
        <p>
          Our mission is to help township vendors run professional operations without expensive
          infrastructure or complicated setup. Kota-OS focuses on practical workflows that work in
          real trading environments where speed and consistency matter.
        </p>
        <p>
          Kota-OS currently offers a full 30-day free trial so businesses can evaluate the platform
          in real service conditions. Commercial plans are being finalized, with a focus on keeping
          long-term access sustainable for growing vendors.
        </p>
      </div>
    </div>
  </section>

  <section class="section-pad bg-brand-surface/45">
    <div class="container-wide">
      <SectionHeader
        title="Who We Serve"
        subtitle="Purpose-built for township food businesses that operate in high-demand, real-world conditions."
      />
      <div class="grid gap-5 md:grid-cols-3">
        {
          WHO_WE_SERVE.map((item) => (
            <article class="card-base card-hover rounded-2xl p-6">
              <h3 class="text-xl font-bold text-brand-foreground">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-brand-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-wide">
      <SectionHeader
        title="Why Vendors Trust Kota-OS"
        subtitle="Reliable software, practical workflows, and support that understands local operating realities."
      />
      <div class="grid gap-5 md:grid-cols-2">
        {
          TRUST_BLOCKS.map((item) => (
            <article class="card-base card-hover rounded-2xl p-7">
              <h3 class="text-xl font-bold text-brand-foreground">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-brand-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide">
      <SectionHeader title="Built by JuveniQ" align="left" />
      <article class="card-base rounded-2xl p-7 md:p-8">
        <p class="text-base leading-relaxed text-brand-muted md:text-lg">
          JuveniQ builds practical digital products for South African businesses. Kota-OS is our
          focused platform for township food vendors who need speed, reliability, and visibility in
          their daily operations.
        </p>
        <dl class="mt-6 grid gap-4 text-sm text-brand-foreground md:grid-cols-2">
          <div>
            <dt class="font-semibold text-brand-muted">Organization</dt>
            <dd class="mt-1 font-medium">JuveniQ (Kota-OS)</dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-muted">Email</dt>
            <dd class="mt-1">
              <a class="text-brand-primary underline" href={`mailto:${CONTACT_INFO.email}`}>
                {CONTACT_INFO.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-muted">Phone</dt>
            <dd class="mt-1">
              <a class="text-brand-primary underline" href={`tel:${CONTACT_INFO.phone}`}>
                {CONTACT_INFO.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-brand-muted">Location</dt>
            <dd class="mt-1">{CONTACT_INFO.location}</dd>
          </div>
          <div class="md:col-span-2">
            <dt class="font-semibold text-brand-muted">Company Registration Number</dt>
            <dd class="mt-1">{LEGAL_INFO.companyRegistrationNumber}</dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <FinalCta />
</BaseLayout>
