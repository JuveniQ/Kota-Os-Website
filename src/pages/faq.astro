---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FinalCta from "@/components/FinalCta.astro";
import FaqAccordion from "@/components/FaqAccordion";
import { FAQ_ITEMS, QUICK_START_STEPS } from "@/data/home-content";
import { faqPageSchema, organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const jsonLd = [
  softwareApplicationSchema("/faq"),
  organizationSchema(),
  faqPageSchema("/faq", FAQ_ITEMS)
];
---

<BaseLayout
  title="Kota-OS FAQ | Licensing, Offline Use, and Support"
  description="Get answers about Kota-OS pricing, licensing, offline capability, support, and upcoming features."
  path="/faq"
  jsonLd={jsonLd}
>
  <PageHero
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about licensing, trial, offline operations, and roadmap updates."
  />

  <section class="section-pad">
    <div class="container-wide max-w-[860px]">
      <SectionHeader title="Common Questions" />
      <FaqAccordion client:visible items={FAQ_ITEMS} />
    </div>
  </section>

  <section class="section-pad bg-brand-surface/45">
    <div class="container-wide max-w-[860px]">
      <SectionHeader title="Quick Start Guide" subtitle="Six simple steps to launch Kota-OS correctly." />
      <ol class="space-y-3 rounded-2xl border border-brand-border bg-white p-6">
        {QUICK_START_STEPS.map((step, index) => (
          <li class="flex gap-3 text-base text-brand-muted">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-primary text-sm font-bold text-white">
              {index + 1}
            </span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide max-w-[860px]">
      <div class="bg-primary-gradient rounded-3xl p-8 text-center text-white">
        <h2 class="text-3xl font-bold md:text-4xl">Still Need Help?</h2>
        <p class="mx-auto mt-3 max-w-2xl text-white/90">
          Reach our support team for licensing assistance, setup guidance, or deployment planning.
        </p>
        <a href="/contact" class="btn mt-6 rounded-2xl bg-white text-brand-primary hover:brightness-110">
          Contact Support
        </a>
      </div>
    </div>
  </section>

  <FinalCta />
</BaseLayout>
