---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ReleaseTimeline from "@/components/ReleaseTimeline";
import FinalCta from "@/components/FinalCta.astro";
import { loadReleaseCatalog } from "@/data/release-catalog";
import { organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const jsonLd = [softwareApplicationSchema("/updates"), organizationSchema()];
const releases = loadReleaseCatalog().versions.map((release) => ({
  ...release,
  date: new Intl.DateTimeFormat("en-ZA", { dateStyle: "long", timeZone: "UTC" }).format(new Date(`${release.date}T00:00:00Z`))
}));
---

<BaseLayout
  title="Kota-OS Updates | Release Notes"
  description="Track Kota-OS features, bug fixes and version history for the Android app."
  path="/updates"
  jsonLd={jsonLd}
>
  <PageHero
    title="Release Notes and Product Updates"
    subtitle="Stay current with each release, including improvements to speed, reliability, reporting, and inventory controls."
  />

  <section class="section-pad">
    <div class="container-wide max-w-[980px]">
      <SectionHeader title="Version Timeline" />
      <ReleaseTimeline items={releases} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>
