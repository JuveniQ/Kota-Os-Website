---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { CONTACT_INFO, LEGAL_INFO } from "@/data/site-config";
import { organizationSchema } from "@/lib/seo";

const jsonLd = [organizationSchema()];
---

<BaseLayout
  title="Security Contact | Kota-OS"
  description="Report security concerns responsibly to the Kota-OS and JuveniQ team."
  path="/security"
  jsonLd={jsonLd}
>
  <PageHero
    title="Security and Responsible Disclosure"
    subtitle="If you discover a potential security issue, report it directly to our team."
    badge="Security Contact"
  />

  <section class="section-pad">
    <div class="container-wide max-w-4xl space-y-6">
      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">How to Report</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-brand-muted">
          <li>Email: {CONTACT_INFO.email}</li>
          <li>Use subject line: Security Report - Kota-OS</li>
          <li>Include impact, steps to reproduce, and supporting evidence</li>
        </ul>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Disclosure Expectations</h2>
        <p class="mt-3 text-brand-muted">
          Please do not publicly disclose vulnerabilities before we have a reasonable opportunity to
          investigate and remediate.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Company Disclosure</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-brand-muted">
          <li>Responsible Party: {LEGAL_INFO.responsibleParty}</li>
          <li>Company Registration Number: {LEGAL_INFO.companyRegistrationNumber}</li>
          <li>Phone: {CONTACT_INFO.phone}</li>
          <li>Location: {CONTACT_INFO.location}</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
