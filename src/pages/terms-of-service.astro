---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { CONTACT_INFO, LEGAL_INFO } from "@/data/site-config";
import { organizationSchema } from "@/lib/seo";

const jsonLd = [organizationSchema()];
---

<BaseLayout
  title="Terms of Service | Kota-OS"
  description="Review the terms that govern use of the Kota-OS website, trial access, and support channels."
  path="/terms-of-service"
  jsonLd={jsonLd}
>
  <PageHero
    title="Terms of Service"
    subtitle="These terms govern use of the Kota-OS website and the current trial access period."
    badge="Legal Terms"
  />

  <section class="section-pad">
    <div class="container-wide max-w-4xl space-y-6">
      <article class="card-base rounded-2xl p-6">
        <p class="text-sm text-brand-muted">Effective Date: February 15, 2026</p>
        <p class="mt-1 text-sm text-brand-muted">Last Updated: February 15, 2026</p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Scope of These Terms</h2>
        <p class="mt-3 text-brand-muted">
          Kota-OS is a POS platform for food vendors. By using this website, downloading software,
          or contacting our team, you agree to these terms.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Eligibility and Account Responsibility</h2>
        <p class="mt-3 text-brand-muted">
          You must provide accurate information and use the service lawfully. You are responsible
          for activities conducted through your contact details or installation environment.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Beta and Trial Clause</h2>
        <p class="mt-3 text-brand-muted">
          Kota-OS currently offers a 30-day trial. This trial is temporary access and does not
          guarantee continued free usage after trial completion.
        </p>
        <p class="mt-3 text-brand-muted">
          Commercial pricing and monetization terms are still being finalized and may apply in
          future. Future plans will be communicated before activation.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Service Modifications and Availability</h2>
        <p class="mt-3 text-brand-muted">
          We may update, improve, suspend, or discontinue features at any time to maintain security,
          reliability, and product direction. We do not guarantee uninterrupted availability.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Acceptable Use</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-brand-muted">
          <li>No unauthorized access, tampering, or reverse engineering</li>
          <li>No fraudulent, unlawful, or abusive use of the service</li>
          <li>No actions that disrupt service stability or security</li>
          <li>No distribution of malware or abusive automation</li>
        </ul>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Intellectual Property</h2>
        <p class="mt-3 text-brand-muted">
          All platform content, branding, software, and documentation remain the intellectual
          property of JuveniQ and its licensors. These terms do not transfer ownership rights.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Disclaimer and Limitation of Liability</h2>
        <p class="mt-3 text-brand-muted">
          The service is provided on an as-available basis. To the maximum extent permitted by law,
          JuveniQ is not liable for indirect, incidental, or consequential losses arising from use
          of the website or trial software.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Indemnity</h2>
        <p class="mt-3 text-brand-muted">
          You agree to indemnify and hold harmless JuveniQ from claims, damages, and costs arising
          from unlawful use, breach of these terms, or misuse of the service.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Suspension and Termination</h2>
        <p class="mt-3 text-brand-muted">
          We may suspend or terminate access for security concerns, policy violations, abuse, or
          legal requirements. You may discontinue use at any time.
        </p>
      </article>

      <article id="user-agreement" class="card-base rounded-2xl p-6 scroll-mt-28">
        <h2 class="text-2xl font-bold text-brand-foreground">User Agreement</h2>
        <p class="mt-3 text-brand-muted">
          Your use of Kota-OS requires compliance with these terms, lawful conduct, and cooperation
          with reasonable security and support procedures.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Governing Law and Jurisdiction</h2>
        <p class="mt-3 text-brand-muted">
          These terms are governed by the laws of South Africa. Any disputes arising from or
          connected to these terms will be subject to the jurisdiction of competent South African
          courts, unless otherwise required by law.
        </p>
      </article>

      <article class="card-base rounded-2xl p-6">
        <h2 class="text-2xl font-bold text-brand-foreground">Notices and Legal Contact</h2>
        <p class="mt-3 text-brand-muted">
          Official notices regarding these terms should be sent to the legal contact points below.
        </p>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-brand-muted">
          <li>Responsible Party: {LEGAL_INFO.responsibleParty}</li>
          <li>Company Registration Number: {LEGAL_INFO.companyRegistrationNumber}</li>
          <li>Email: {CONTACT_INFO.email}</li>
          <li>Phone: {CONTACT_INFO.phone}</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
