---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FinalCta from "@/components/FinalCta.astro";
import { organizationSchema, softwareApplicationSchema } from "@/lib/seo";
---

<BaseLayout
  title="Kota-OS Pricing | 14-Day Trial"
  description="Kota-OS starts with a 14-day trial. See your available plan and payment method in your installation channel before purchasing."
  path="/pricing"
  jsonLd={[softwareApplicationSchema("/pricing"), organizationSchema()]}
>
  <PageHero
    title="Start with 14 days to try Kota-OS"
    subtitle="Run real sales, map recipe ingredients and check reports during your trial. We will show your available plan and price before any purchase."
    badge="Gauteng pilot"
  />
  <section class="section-pad bg-white">
    <div class="container-wide max-w-4xl">
      <article class="card-base rounded-2xl p-8">
        <h2 class="text-2xl font-bold text-brand-foreground">A plan for how you install</h2>
        <p class="mt-4 text-brand-muted">Download is free. The trial starts at account registration and lasts 14 days. After the trial, premium access requires a subscription unless another entitlement applies to your account.</p>
        <p class="mt-4 text-brand-muted">Google Play, App Store and Galaxy Store builds use their respective store purchase flow when available. The official website build offers direct checkout. You will see the available price, billing period and renewal terms in the app before you pay.</p>
        <p class="mt-4 text-brand-muted">Your account access follows you across supported devices; a single purchase should be managed in the store where you made it. One account may link up to three active devices; contact support to request more.</p>
        <a href="/download" class="btn-primary mt-6 inline-flex">Request pilot access</a>
      </article>
    </div>
  </section>
  <FinalCta title="See Kota-OS in a real service" subtitle="Tell us about your food business and request a guided pilot place." />
</BaseLayout>
