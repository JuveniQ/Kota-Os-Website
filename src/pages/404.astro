---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { CONTACT_INFO } from "@/data/site-config";
---

<BaseLayout
  title="Page not found | Kota-OS"
  description="The page you were looking for could not be found."
  path="/404"
  noindex
>
  <PageHero
    title="Page not found"
    subtitle="This link may be out of date, or the page has moved. If you were looking for the Android app, the download page always has the current installers."
    badge="404"
  />

  <section class="section-pad">
    <div class="container-wide max-w-3xl">
      <div class="card-base rounded-3xl p-6 sm:p-8">
        <h2 class="text-xl font-bold text-brand-foreground">Where to next?</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          <li><a href="/download" class="block rounded-2xl border-2 border-brand-primary/30 bg-brand-primary/5 px-4 py-4 font-bold text-brand-foreground transition hover:border-brand-primary">Download the latest app</a></li>
          <li><a href="/" class="block rounded-2xl border-2 border-brand-primary/30 bg-brand-primary/5 px-4 py-4 font-bold text-brand-foreground transition hover:border-brand-primary">Go to the home page</a></li>
          <li><a href="/faq" class="block rounded-2xl border-2 border-brand-primary/30 bg-brand-primary/5 px-4 py-4 font-bold text-brand-foreground transition hover:border-brand-primary">Read the FAQ</a></li>
          <li><a href="/contact" class="block rounded-2xl border-2 border-brand-primary/30 bg-brand-primary/5 px-4 py-4 font-bold text-brand-foreground transition hover:border-brand-primary">Contact support</a></li>
        </ul>
        <a class="mt-5 inline-block text-sm font-semibold text-brand-primary underline" href={`mailto:${CONTACT_INFO.email}`}>Need help? {CONTACT_INFO.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
