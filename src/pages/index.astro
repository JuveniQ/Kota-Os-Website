---
import BaseLayout from "@/layouts/BaseLayout.astro";
import FinalCta from "@/components/FinalCta.astro";
import Hero from "@/components/Hero";
import SectionHeader from "@/components/SectionHeader.astro";
import HowItWorksTimeline from "@/components/HowItWorksTimeline";
import ScreenshotsCarousel from "@/components/ScreenshotsCarousel";
import FaqAccordion from "@/components/FaqAccordion";
import BenefitCard from "@/components/BenefitCard";
import FeaturesGrid from "@/components/FeaturesGrid";
import {
  BENEFITS,
  FAQ_ITEMS,
  FEATURE_ITEMS,
  HERO_METRICS,
  HOW_IT_WORKS,
  SCREENSHOT_SLIDES
} from "@/data/home-content";
import { SITE_META } from "@/data/site-config";
import { faqPageSchema, localBusinessSchema, organizationSchema, softwareApplicationSchema } from "@/lib/seo";

const jsonLd = [
  softwareApplicationSchema("/"),
  localBusinessSchema("/"),
  organizationSchema(),
  faqPageSchema("/", FAQ_ITEMS)
];
---

<BaseLayout
  title={SITE_META.title}
  description={SITE_META.description}
  path="/"
  jsonLd={jsonLd}
>
  <Hero client:load metrics={HERO_METRICS} />

  <section id="features" class="section-pad scroll-mt-28">
    <div class="container-wide">
      <SectionHeader
        title="Food-business operations, even offline"
        subtitle="Keep selling, track the ingredients used in each recipe, spot low stock and see how your shop is doing."
      />
      <FeaturesGrid items={FEATURE_ITEMS} />
    </div>
  </section>

  <section id="how-it-works" class="section-pad scroll-mt-28 bg-brand-surface/45">
    <div class="container-wide">
      <SectionHeader title="Three Steps to Success" />
      <HowItWorksTimeline steps={HOW_IT_WORKS} />
    </div>
  </section>

  <section id="screenshots" class="section-pad scroll-mt-28">
    <div class="container-wide">
      <SectionHeader title="See It In Action" subtitle="Operational clarity from the first tap." />
      <ScreenshotsCarousel client:load slides={SCREENSHOT_SLIDES} />
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-wide">
      <SectionHeader title="Built for Your Success" />
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {BENEFITS.map((benefit) => <BenefitCard benefit={benefit} />)}
      </div>
    </div>
  </section>

  <section id="faq" class="section-pad scroll-mt-28 bg-white">
    <div class="container-wide max-w-[840px]">
      <SectionHeader title="Frequently Asked Questions" />
      <FaqAccordion client:visible items={FAQ_ITEMS} />
    </div>
  </section>

  <FinalCta />
</BaseLayout>
