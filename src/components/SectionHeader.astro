---
type Props = {
  title: string;
  subtitle?: string;
  align?: "left" | "center";
};

const { title, subtitle, align = "center" } = Astro.props;
---

<div class:list={["mb-10", align === "center" ? "text-center" : "text-left"]}>
  <h2 class="text-[32px] font-extrabold leading-tight text-brand-foreground md:text-[40px]">{title}</h2>
  {subtitle ? <p class="mx-auto mt-3 max-w-3xl text-lg text-brand-muted">{subtitle}</p> : null}
</div>
