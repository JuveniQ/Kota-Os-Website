---
type Props = {
  title: string;
  subtitle: string;
  badge?: string;
};

const { title, subtitle, badge } = Astro.props;
---

<section class="bg-hero-gradient pt-28">
  <div class="container-wide section-pad">
    {badge ? (
      <span class="inline-flex rounded-full border border-brand-primary/30 bg-brand-warning/20 px-3 py-1 text-xs font-semibold text-brand-foreground">
        {badge}
      </span>
    ) : null}
    <h1 class="mt-4 max-w-4xl text-4xl font-extrabold text-brand-primary md:text-6xl">{title}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-brand-muted md:text-xl">{subtitle}</p>
  </div>
</section>
